#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "abi.glsl"
#include "hb.glsl"
void main(){
    uint buttons = hbPressed();
    c.motion.x += 1.0 / 60.0;
    c.state.z++;
    c.transition.x = max(0.0, c.transition.x - 1.0 / 15.0);
    
    if (hbConnected()) {
        if ((buttons & HB_DPAD_UP) != 0u) {
            c.library.x = mod(c.library.x + 5.0, 6.0);
        }
        if ((buttons & HB_DPAD_DOWN) != 0u) {
            c.library.x = mod(c.library.x + 1.0, 6.0);
        }
        if ((buttons & HB_A) != 0u) {
            c.state.w = c.state.w == 1.0 ? 2.0 : 1.0;
        }
        if ((buttons & HB_X) != 0u) {
            c.state.w = 0.0;
        }
        if ((buttons & (HB_B | HB_MINUS)) != 0u) {
            hbExit();
        }
    }
    hbEndFrame();
}
