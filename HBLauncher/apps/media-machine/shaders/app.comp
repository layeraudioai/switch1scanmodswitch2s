#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "abi.glsl"
#include "hb.glsl"
#include "text.glsl"

void main(){
    uint buttons = hbPressed();
    c.motion.x += 1.0 / 60.0;
    c.state.z++;
    c.transition.x = max(0.0, c.transition.x - 1.0 / 15.0);

    // D-Pad Up / Down navigation
    if ((buttons & HB_UP) != 0u) {
        c.game.x = (c.game.x + uint(NUM_FILES) - 1u) % uint(NUM_FILES);
    }
    if ((buttons & HB_DOWN) != 0u) {
        c.game.x = (c.game.x + 1u) % uint(NUM_FILES);
    }
    // A button: Select file and pass to Switch 2 for client-side playback
    if ((buttons & HB_A) != 0u) {
        c.game.y = 1u; // Selected / Transferred status flag
        c.game.z = c.game.x; // Selected file index
    }
    // X button: Clear selection
    if ((buttons & HB_X) != 0u) {
        c.game.y = 0u;
    }
    // Exit via B or Minus
    if (hbConnected() && (buttons & (HB_B | HB_MINUS)) != 0u) {
        hbExit();
    }

    hbEndFrame();
}
